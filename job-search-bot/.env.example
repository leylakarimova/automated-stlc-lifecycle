# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Ключ Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Ваш Telegram user id (узнать у @userinfobot). Через запятую, если несколько.
# Пусто = бот отвечает всем (не рекомендуется: каждый поиск тратит API).
ALLOWED_USER_IDS=
# Модель Claude для сравнения вакансий с CV
CLAUDE_MODEL=claude-opus-5-5
# Как часто искать новые вакансии (часы)
CHECK_INTERVAL_HOURS=6
# Сколько вакансий максимум отправлять на оценку Claude за один прогон
MAX_VACANCIES_PER_RUN=40
# Путь к базе SQLite
DB_PATH=jobbot.sqlite3
